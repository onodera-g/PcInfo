!/src/diagnostics.py
!/src/dialogs.py
!/src/gpu_diagnostics.py
!/src/log_writer.py
!/src/main.py
!/src/powershell_utils.py
!/src/storage_diagnostics.py
!/src/system_info.py
!/src/ui_components.py
!/src/utils.py
!/src/CrystalDiskInfo/
/src/CrystalDiskInfo/*
!/src/CrystalDiskInfo/dummy.txt
!/src/icons/
/src/icons/*
!/src/icons/app_icon.ico
!/src/icons/chip.png
!/src/icons/computer.png
!/src/icons/device_hub.png
!/src/icons/disk.png
!/src/icons/memory.png
!/src/icons/video_library.png
!/src/log/
/src/log/*
!/src/log/storage_health_log_20241013_040713.txt
!/src/tabs/
/src/tabs/*
