# GitHubの既存公開ファイルだけを同期する。
# 公開ファイルを追加する場合は、対象を確認してこの許可一覧へ追加する。
/*
!/.gitignore
!/README.md
!/requirements.txt
!/dist/
/dist/*
!/dist/PcInfo.exe
!/dist/README.txt
!/src/
/src/*
